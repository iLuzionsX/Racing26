{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:track": "tsx src/graphics/tracks/showcaseCircuitQA.ts",
    "test:visual-track": "tsx src/graphics/tracks/showcase/showcaseVisualQA.ts",
    "test:conventions": "tsx src/physics/tests/PhysicsConventionTests.ts",
    "test:digital-steering": "tsx src/physics/tests/DigitalSteeringInputTests.ts",
    "test:mouse-steering": "tsx src/physics/tests/MouseSteeringInputTests.ts",
    "test:turn-radius": "tsx src/physics/tests/TurnRadiusTests.ts",
    "test:suspension": "tsx src/physics/tests/SuspensionBehaviorTests.ts",
    "test:kinematics": "tsx src/physics/tests/SuspensionKinematicsTests.ts",
    "test:kinematics-arb": "tsx src/physics/tests/SuspensionKinematicsAntiRollIntegrationTests.ts",
    "test:corner-load": "tsx src/physics/tests/DynamicCornerLoadTests.ts",
    "test:cornering": "tsx src/physics/tests/LowSpeedCorneringTests.ts",
    "test:powered-full-lock": "tsx src/physics/tests/PoweredFullLockJiggleTests.ts",
    "test:crawl": "tsx src/physics/tests/CrawlSpeedStabilityTests.ts",
