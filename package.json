    "test:tire-feel": "tsx src/physics/tests/TireFeelSteeringSweepTests.ts",
    "test:smoke": "tsx src/physics/tests/TireSmokeRegressionTests.ts",
    "test:crash": "tsx src/physics/tests/CrashStabilityTests.ts",
    "test:crash-recovery": "tsx src/physics/tests/CrashRecoveryTests.ts",
    "test:wheel-visual": "tsx src/physics/tests/WheelVisualPoseTests.ts",
    "test:steering-direction": "tsx src/physics/tests/SteeringDirectionTests.ts",
    "test:visual-scale": "tsx src/physics/tests/VisualScaleTests.ts",
    "test:automatic": "tsx src/physics/tests/AutomaticTransmissionTests.ts",
    "test:m5-rwd": "tsx src/physics/tests/M5DriveModeTests.ts",
    "test:m5-transient": "tsx src/physics/tests/M5TransientResponseTests.ts",
